# Set these before first startup. The admin user is created only on an empty database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-with-a-unique-password-of-at-least-14-characters

# Host port on the Raspberry Pi. Keep this LAN-only; do not port-forward it.
PORT=3000
COOKIE_SECURE=false
TZ=Europe/Oslo

# Optional server-to-server estimated-keg snapshot for the tap display.
# Set the SAME dedicated secret on both servers (32+ printable non-whitespace ASCII
# characters, e.g. openssl rand -hex 32). Keep separate from payment display secrets.
# Tracking remains disabled until configured through Admin with real product IDs.
KEG_TRACKING_SECRET=

